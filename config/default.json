{
  "app": {
    "name": "LocalVideoAI",
    "display_name": "LocalVideoAI Translator",
    "language": "zh-CN",
    "theme": "system",
    "target_language": "zh-CN"
  },
  "ui": {
    "last_page": "workspace",
    "main_splitter": [240, 760, 300],
    "center_splitter": [620, 100]
  },
  "privacy": {
    "allow_network": false,
    "upload_media": false,
    "upload_subtitles": false,
    "upload_projects": false
  },
  "hardware": {
    "device": "auto",
    "prefer_gpu": true,
    "cpu_threads": 0
  },
  "batch": {
    "device": "auto",
    "prefer_gpu": true,
    "cpu_threads": 0,
    "max_concurrent": 1,
    "ram_limit_gb": 0,
    "min_free_ram_gb": 1.5
  },
  "paths": {
    "models_dir": "",
    "projects_dir": "",
    "cache_dir": "",
    "ffmpeg_dir": "vendor/ffmpeg"
  },
  "models": {
    "disabled": [],
    "active": {}
  },
  "realtime": {
    "delay_ms": 3000,
    "profile": "balanced"
  },
  "project": {
    "autosave_seconds": 15,
    "prompt_recovery": true
  },
  "export": {
    "format": "srt",
    "mode": "embed",
    "burn_in": false,
    "output_dir": "",
    "container": "mp4",
    "video_codec": "copy"
  },
  "logging": {
    "level": "INFO",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "update": {
    "source": ""
  }
}
